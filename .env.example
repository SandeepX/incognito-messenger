APP_NAME="Incognito Messenger"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# SQLite: WAL + busy timeout avoid lock errors during concurrent call signaling.
# DB_BUSY_TIMEOUT=10000
# DB_JOURNAL_MODE=wal
# DB_TRANSACTION_MODE=IMMEDIATE
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=minio
QUEUE_CONNECTION=database

# Reverb server socket (php artisan reverb:start listens on all interfaces).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Laravel -> Reverb publishing stays on the host loopback. In Docker, compose
# overrides REVERB_HOST with the internal service name `reverb`.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Browser Echo derives wsHost, port and TLS from window.location, so no host
# or port is baked into the JS bundle. Leave these empty for the single-origin
# Caddy setup (see docs/lan-https-setup.md). For a split setup where Reverb is
# on its own port with no proxy, set REVERB_BROWSER_PORT=8080.
REVERB_BROWSER_PORT=
REVERB_BROWSER_PATH=
# Comma-separated origins allowed to open the WebSocket. Use the LAN HTTPS
# origin, e.g. https://192.168.1.10:8443. '*' is fine for local development.
# Reverb compares only the hostname from the Origin header (no scheme/port).
# Use '*' for local development; bare host(s) for a single-origin HTTPS setup.
REVERB_ALLOWED_ORIGINS=*

# LAN HTTPS (Caddy) proxy settings. Read host/IP values from .env — never
# hardcode them in application code. See docs/lan-https-setup.md.
# APP_URL=https://192.168.1.10:8443
TRUSTED_PROXIES=127.0.0.1
TRUSTED_HOSTS=
CORS_ALLOWED_ORIGINS=
# Set to true when serving over HTTPS so the session cookie is Secure.
SESSION_SECURE_COOKIE=

# Only the app key is still read by the browser build (public, non-secret).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"

# ---------------------------------------------------------------------------
# WebRTC audio calls
# ---------------------------------------------------------------------------
# STUN is enough on the same LAN. Calls between different networks need a
# TURN relay (see README). Comma-separated lists are supported. TURN
# credentials are sent only to authenticated browsers by /api/calls/config.
WEBRTC_STUN_URLS="stun:stun.l.google.com:19302"
# WEBRTC_TURN_URLS="turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp"
# WEBRTC_TURN_USERNAME=
# WEBRTC_TURN_CREDENTIAL=

# File cache keeps throttle/rate-limit writes out of SQLite. Database cache
# uses a write transaction that can hit "database is locked" on concurrent
# call signaling, so prefer file (or Redis) for this app.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# MinIO — private, S3-compatible object storage for every uploaded file.
# Never expose MINIO_SECRET_KEY to the browser.
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=incognito
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_URL=http://localhost:19000
